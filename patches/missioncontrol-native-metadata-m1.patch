         R_SUCCEED();
     }
+    Result MissionControlService::ProbeNativeMetadata(u32 nonce) {
+        if (!amazon_observer::BeginNativeMetadataProbe(nonce))
+            return MAKERESULT(Module_Libnx, LibnxError_BadInput);
+        const struct { u32 command, magic, nonce; } request{6, 0x314d5241, nonce};
+        // A fixed diagnostic round-trip only. No caller-supplied HCI or keys.
+        const BtdrvAddress zero{};
+        R_RETURN(btdrvWriteHidData2(zero, &request, sizeof(request)));
+    }
+    Result MissionControlService::GetNativeMetadata(const sf::OutPointerBuffer &out_buffer) {
+        if (!amazon_observer::ReadNativeMetadata(out_buffer.GetPointer(), out_buffer.GetSize()))
+            return MAKERESULT(Module_Libnx, LibnxError_BadInput);
+        R_SUCCEED();
+    }
