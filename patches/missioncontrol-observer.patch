+    Result MissionControlService::GetTargetSighting(const sf::OutPointerBuffer &out_buffer) {
+        // Exact fixed-size output; no Bluetooth command or state mutation.
+        if (!amazon_observer::ReadTargetSighting(out_buffer.GetPointer(), out_buffer.GetSize()))
+            return MAKERESULT(Module_Libnx, LibnxError_BadInput);
+        R_SUCCEED();
+    }
+    Result MissionControlService::ArmTargetCapture() {
+        if (!amazon_observer::ArmTargetCapture()) return MAKERESULT(Module_Libnx, LibnxError_BadInput);
+        R_SUCCEED();
+    }
+    Result MissionControlService::GetCaptureStatus(const sf::OutPointerBuffer &out_buffer) {
+        if (!amazon_observer::ReadCaptureStatus(out_buffer.GetPointer(), out_buffer.GetSize()))
+            return MAKERESULT(Module_Libnx, LibnxError_BadInput);
+        R_SUCCEED();
+    }
+    Result MissionControlService::EndTargetCapture() {
+        amazon_observer::EndTargetCapture();
+        R_SUCCEED();
+    }
+
