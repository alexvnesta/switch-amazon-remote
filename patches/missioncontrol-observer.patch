+    Result BtdrvMitmService::TraceBleIntent(u32 command, const void *payload, size_t size) {
+        // The IPC server is the sole producer. Never wait for a callback or issue
+        // another driver command here. The SF sentinel forwards the ORIGINAL
+        // saved request, not reconstructed metadata, preserving driver results.
+        ams::mc::ble_intent_trace::Observe(command, m_client_info.program_id.value,
+            m_client_info.process_id.value, payload, size);
+        R_RETURN(sm::mitm::ResultShouldForwardToSession());
+    }
